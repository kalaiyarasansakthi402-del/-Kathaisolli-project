# ==========================================
# Kathaisolli Environment Variables Template
# Copy to .env for local development
# NEVER commit .env with real secrets to GitHub
# ==========================================

# Backend Environment
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kathaisolli:kathaisolli_dev@localhost:5432/kathaisolli?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# In production, add your deployed Vercel domain to CORS_ORIGINS (e.g. https://your-project.vercel.app)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,https://your-kathaisolli.vercel.app

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kathaisolli-audio
S3_ACCESS_KEY=kathaisolli
S3_SECRET_KEY=change-this-local-development-secret
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=300
MAX_AUDIO_UPLOAD_BYTES=524288000
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# Seed Defaults
SEED_DEMO_LISTENER_PASSWORD=
SEED_DEMO_CREATOR_PASSWORD=
SEED_DEMO_ADMIN_PASSWORD=

# Frontend Environment (Vercel Project Settings)
VITE_API_URL=https://your-api-domain.com

# Firebase Web SDK Configuration
# Project: vaagai-audio-books-36a4e
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=vaagai-audio-books-36a4e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vaagai-audio-books-36a4e
VITE_FIREBASE_STORAGE_BUCKET=vaagai-audio-books-36a4e.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_STORIES_PATH=stories

