{
  "name": "kathaisolli",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "pnpm --filter @kathaisolli/api run test --runInBand",
    "dev:api": "pnpm --filter @kathaisolli/api start:dev",
    "build:api": "pnpm --filter @kathaisolli/api build",
    "test:api": "pnpm --filter @kathaisolli/api run test --runInBand",
    "dev:web": "pnpm --filter @kathaisolli/web dev",
    "build:web": "pnpm --filter @kathaisolli/web... build",
    "dev:admin": "pnpm --filter @kathaisolli/admin dev",
    "build:admin": "pnpm --filter @kathaisolli/admin build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @kathaisolli/api prisma:generate",
    "db:migrate": "pnpm --filter @kathaisolli/api prisma:migrate",
    "db:deploy": "pnpm --filter @kathaisolli/api prisma:deploy",
    "db:seed": "pnpm --filter @kathaisolli/api prisma:seed",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0"
  }
}
