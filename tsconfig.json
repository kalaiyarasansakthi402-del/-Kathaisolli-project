{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolvePackageJsonExports": true,
    "strict": true,
    "skipLibCheck": false,
    "typeRoots": [
      "./node_modules/@types",
      "./apps/api/node_modules/@types"
    ],
    "types": ["node"]
  },
  "include": ["api/**/*.ts"]
}
