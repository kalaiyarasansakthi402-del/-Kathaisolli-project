{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolvePackageJsonExports": true,
    "strict": false,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types",
      "../apps/api/node_modules/@types"
    ],
    "types": ["node"]
  },
  "include": ["./**/*.ts"]
}
