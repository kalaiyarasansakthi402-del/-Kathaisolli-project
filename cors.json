[
  {
    "origin": ["*"],
    "method": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Content-Range",
      "Range",
      "Accept-Ranges",
      "Origin",
      "X-Requested-With",
      "Access-Control-Allow-Origin",
      "ETag",
      "x-goog-resumable"
    ],
    "maxAgeSeconds": 3600
  }
]
