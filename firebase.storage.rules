rules_version = '2';

// Firebase Storage Security Rules for Kathaisolli (vaagai-audio-books-36a4e)
service firebase.storage {
  match /b/{bucket}/o {
    
    // Stories folder: Public read for streaming audiobooks, admin-only writes
    // NEVER publicly writable
    match /stories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Audio folder alias
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // User personal storage: Read and write only by the authenticated owner
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
