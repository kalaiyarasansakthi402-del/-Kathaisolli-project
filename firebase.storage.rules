rules_version = '2';

// Firebase Storage Security Rules for Kathaisolli (vaagai-audio-books-36a4e)
service firebase.storage {
  match /b/{bucket}/o {
    
    // User personal storage: Read and write only by the authenticated owner
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read for published audiobook/video media and cover artwork
    // Writes restricted to authenticated admins/creators with configurable size (up to 2GB) and media MIME validation
    match /kathaisolli/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.admin == true || request.auth.token.role in ['ADMIN', 'SUPER_ADMIN', 'CREATOR'])
        && request.resource != null
        && request.resource.size < 2048 * 1024 * 1024
        && (
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType in ['application/ogg', 'application/mp4', 'application/mxf', 'application/octet-stream']
        );
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
