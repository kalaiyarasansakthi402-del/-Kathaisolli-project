rules_version = '2';

// Firebase Storage Security Rules for Kathaisolli (vaagai-audio-books-36a4e)
service firebase.storage {
  match /b/{bucket}/o {
    
    // User personal storage: Read and write only by the authenticated owner
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read for all published audiobook files (MP3, OGG, cover artwork)
    // Allows normal guest and registered users to stream audio without 403 errors
    // Write access is strictly restricted to authorized admins (never publicly writable)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
