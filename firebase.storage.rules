rules_version = '2';

// Firebase Storage Security Rules for Kathaisolli (vaagai-audio-books-36a4e)
service firebase.storage {
  match /b/{bucket}/o {
    
    // User personal storage: Read and write only by the authenticated owner
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read for all published audiobook files (MP3, OGG, cover artwork)
    // Allows admin uploads for stories, books, cover artwork and chapter audio
    match /kathaisolli/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
